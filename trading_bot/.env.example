# ─── Copy this file to .env and fill in your values ───────────────────────────
# cp .env.example .env

# REQUIRED: Personal Access Token (PAT) — get it from:
#   https://developers.deriv.com/dashboard/profile/tokens
#   (NOT from api.deriv.com — that is the old API with a different token format)
#   Scopes needed: Account Manage + Trade
DERIV_API_TOKEN=your_pat_token_here

# Your App ID from https://developers.deriv.com/dashboard/applications (alphanumeric)
DERIV_APP_ID=your_app_id_here

# Your Deriv account ID (shown on your Deriv dashboard, e.g. DOT90279522 or CR1234567)
DERIV_ACCOUNT_ID=your_account_id_here

# ─── Account settings ──────────────────────────────────────────────────────────
TRADING_CURRENCY=AUD
TRADING_STARTING_BALANCE=100.0

# ─── Market settings ───────────────────────────────────────────────────────────
# Single symbol (used if TRADING_SYMBOLS is not set):
#   R_10  = Volatility 10 Index  (lowest volatility)
#   R_25  = Volatility 25 Index  (medium volatility)
#   R_50  = Volatility 50 Index  (higher volatility)
#   R_75  = Volatility 75 Index  (very high volatility)
#   R_100 = Volatility 100 Index (highest volatility)
TRADING_SYMBOL=R_25

# Multiple symbols (comma-separated) — bot rotates through them each cycle:
#   Volatility: R_10, R_25, R_50, R_75, R_100
#   Boom:       BOOM300N, BOOM500N, BOOM1000N
#   Crash:      CRASH300N, CRASH500N, CRASH1000N
TRADING_SYMBOLS=CRASH500N,R_25,R_50,R_100

# Contract duration (how long each trade lasts)
TRADING_DURATION=5     # 5 minutes

# ─── Risk management ───────────────────────────────────────────────────────────
# Maximum % of balance to risk per trade (recommended: 1-2%)
TRADING_MAX_RISK_PCT=2.0

# Stop trading for the day if losses exceed this % of starting balance
TRADING_MAX_DAILY_LOSS_PCT=10.0

# Pause trading when daily profit reaches this % (take wins and rest)
TRADING_DAILY_TARGET_PCT=3.0

# ─── Logging ───────────────────────────────────────────────────────────────────
TRADING_LOG_LEVEL=INFO
